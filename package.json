{
  "name": "wheresthefx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Metro Manila event discovery — map, ingestion pipeline, and API",
  "workspaces": [
    "app/*",
    "package/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "npm run dev --workspace @wheresthefx/web",
    "dev:api": "npm run dev --workspace @wheresthefx/api",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @wheresthefx/db",
    "db:migrate": "npm run db:migrate --workspace @wheresthefx/db",
    "db:studio": "npm run db:studio --workspace @wheresthefx/db"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
