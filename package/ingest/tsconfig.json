{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is needed for the code inside page.evaluate, which runs in the
    // browser rather than in Node.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@wheresthefx/core": ["../core/src/index.ts"],
      "@wheresthefx/db": ["../db/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
