{
  "name": "@wheresthefx/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, connection, and migration — the single source of truth for the database",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./connection": "./src/connection.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "tsx script/generate.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.39.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
