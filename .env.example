# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wheresthefx

# JWT — REQUIRED. The API refuses to start without it, and rejects
# anything shorter than 32 chars. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# Source data for the ingest script.
# `data/ig-events.db` is recovered from the VPS; see docs/ingest.md.
BLEAD_DB_PATH=./data/ig-events.db
# The image cache is ~3.6GB and stays on the VPS — point this at a local
# copy only if you have one, otherwise the proxy falls back to the CDN.
BLEAD_IMAGES_PATH=

# API server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Web client (Vite only injects VITE_-prefixed vars)
VITE_API_URL=http://localhost:3001

# ── Instagram session ────────────────────────────────────────────────
# Capture a session with:  npm run ig:login --workspace @wheresthefx/ingest
# Runs headed by default, because Instagram answers automated logins with
# checkpoints (2FA, "was this you?", captcha) that only a person can clear.
IG_USERNAME=
IG_PASSWORD=
IG_SESSION_PATH=data/session/ig-session.json
# Optional. Overrides the preset; keep credentials out of tracked config.
IG_PROXY_URL=

# ── Extraction backend ───────────────────────────────────────────────
# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, Groq, a local
# Ollama (http://localhost:11434/v1), or Gemini's compat endpoint.
EXTRACT_BASE_URL=https://api.openai.com/v1
EXTRACT_API_KEY=
EXTRACT_MODEL=gpt-4.1-mini

# ── Ingest scheduler ─────────────────────────────────────────────────
# Hours between scrapes. 0 disables it. The API runs this itself, so
# there is no crontab entry to forget.
INGEST_INTERVAL_HOUR=0
INGEST_INITIAL_DELAY_MINUTE=5

# ── Geocoding ────────────────────────────────────────────────────────
# Nominatim (OpenStreetMap) is free and needs no key, but their usage
# policy asks for a contact address so they can reach you before
# blocking. Without it the VPS IP is what gets blocked.
GEOCODE_CONTACT=
