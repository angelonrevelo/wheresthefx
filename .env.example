# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wheresthefx

# JWT — REQUIRED. The API refuses to start without it, and rejects
# anything shorter than 32 chars. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# Source data for the ingest script.
# `data/ig-events.db` is recovered from the VPS; see docs/ingest.md.
BLEAD_DB_PATH=./data/ig-events.db
# The image cache is ~3.6GB and stays on the VPS — point this at a local
# copy only if you have one, otherwise the proxy falls back to the CDN.
BLEAD_IMAGES_PATH=

# API server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Web client (Vite only injects VITE_-prefixed vars)
VITE_API_URL=http://localhost:3001
