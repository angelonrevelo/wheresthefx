{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@wheresthefx/db": ["../../package/db/src/index.ts"],
      "@wheresthefx/db/*": ["../../package/db/src/*"],
      "@wheresthefx/core": ["../../package/core/src/index.ts"],
      "@wheresthefx/core/*": ["../../package/core/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
